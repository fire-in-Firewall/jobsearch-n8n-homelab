    {
      "parameters": {
        "jsCode": "// ----------------------------\n// Node6: Prepare Jobs For Fit Engine\n// ----------------------------\n\nconst jobs = $input.all().map(item => {\n  const page = item.json;\n\n  const postedDate = page.property_date_posted?.start ?? null;\n  const preview = page.property_job_description_preview ?? '';\n  const isTruncated = page.property_job_description_truncated === true;\n\n  let structured = {};\n  let structuredValid = false;\n\n  const raw = page.property_structured_requirements;\n\n  // ----------------------------\n  // Case 1 — Already Object\n  // ----------------------------\n  if (typeof raw === \"object\" && raw !== null && !Array.isArray(raw)) {\n    structured = raw;\n  }\n\n  // ----------------------------\n  // Case 2 — Plain JSON String\n  // ----------------------------\n  else if (typeof raw === \"string\" && raw.trim().length > 0) {\n    try {\n      structured = JSON.parse(raw.trim());\n    } catch (e) {\n      console.error(\"Structured JSON parse failed (string):\", {\n        job_page_id: page.id,\n        error: e.message\n      });\n      structured = {};\n    }\n  }\n\n  // ----------------------------\n  // Case 3 — Rich Text Array\n  // ----------------------------\n  else if (raw?.rich_text && Array.isArray(raw.rich_text)) {\n    const fullString = raw.rich_text\n      .map(r => r?.text?.content || \"\")\n      .join(\"\");\n\n    if (fullString.trim().length > 0) {\n      try {\n        structured = JSON.parse(fullString.trim());\n      } catch (e) {\n        console.error(\"Structured JSON parse failed (rich_text):\", {\n          job_page_id: page.id,\n          error: e.message\n        });\n        structured = {};\n      }\n    }\n  }\n\n  // ----------------------------\n  // Normalize Structure\n  // ----------------------------\n  structured.must_have = Array.isArray(structured.must_have)\n    ? structured.must_have\n    : [];\n\n  structured.nice_to_have = Array.isArray(structured.nice_to_have)\n    ? structured.nice_to_have\n    : [];\n\n  structured.hard_constraints = Array.isArray(structured.hard_constraints)\n    ? structured.hard_constraints\n    : [];\n\n  structured.experience =\n    structured.experience && typeof structured.experience === \"object\"\n      ? structured.experience\n      : { min_years: null, seniority_level: \"unknown\" };\n\n  structured.role_cluster_hint =\n    structured.role_cluster_hint ?? page.property_job_cluster ?? \"general\";\n\n  structured.role_title =\n    structured.role_title ?? page.property_position ?? \"\";\n\n  // ----------------------------\n  // JSON Integrity Check\n  // ----------------------------\n  if (\n    typeof structured === \"object\" &&\n    structured.must_have &&\n    structured.nice_to_have &&\n    structured.hard_constraints &&\n    structured.experience\n  ) {\n    structuredValid = true;\n  }\n\n  return {\n    json: {\n      job_page_id: page.id,\n      job_url: page.property_url ?? '',\n      job_title: page.property_position ?? '',\n      company: page.property_company ?? '',\n      location: page.property_location ?? '',\n      posted_date: postedDate,\n      description_preview: preview,\n      description_truncated: isTruncated,\n      structured_requirements: structured,\n      structured_valid: structuredValid,\n      job_minimum_years: page.property_job_minimum_years ?? null,\n      job_seniority: page.property_job_seniority ?? null,\n      job_cluster: page.property_job_cluster ?? null,\n      job_slug: page.property_slug ?? ''\n    }\n  };\n});\n\nreturn jobs;\n"
      },
